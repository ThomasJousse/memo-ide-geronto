{
  "name": "memo-ide-geronto",
  "version": "1.0.0",
  "private": true,
  "description": "Mémo IDE Géronto — carnet de poche hors ligne pour infirmière d'équipe mobile de gériatrie",
  "type": "module",
  "scripts": {
    "content": "node scripts/build-content.mjs",
    "check": "node scripts/build-content.mjs --check",
    "test": "node scripts/test-aggir.mjs",
    "dev": "npm run content && vite",
    "build": "npm run content && vite build",
    "preview": "vite preview",
    "sync": "npm run build && cap sync android",
    "apk:debug": "npm run sync && cd android && gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "js-yaml": "^4.1.0",
    "marked": "^15.0.0",
    "vite": "^6.3.0"
  }
}
